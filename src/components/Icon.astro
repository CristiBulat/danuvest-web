---
/**
 * Icon.astro — zero-runtime-JS inline SVG icon system.
 *
 * Renders a single 24x24 SVG icon by name. Outline icons inherit colour via
 * `stroke="currentColor"`; the two brand marks (whatsapp, viber) render as
 * solid `fill="currentColor"` shapes instead. Nothing here ships any JS to
 * the client — this is pure build-time/SSR markup.
 *
 * Usage:
 *   ---
 *   import Icon from './Icon.astro'
 *   ---
 *   <Icon name="crane" />
 *   <Icon name="phone" size={24} class="contact-action-icon" />
 *
 * See docs/icon-map.md for the full emoji → icon-name migration table and
 * source attribution for adapted icons.
 */

export interface Props {
  /** Icon name — must be one of the keys in ICONS below. */
  name: string
  /** Width/height in pixels. Both viewBox axes are 24, so this scales uniformly. */
  size?: number
  /** Passed through to the rendered <svg class="..."> attribute. */
  class?: string
}

type IconKind = 'stroke' | 'fill'

interface IconDef {
  kind: IconKind
  /** Inner SVG markup (paths/shapes only — the wrapping <svg> is rendered below). */
  body: string
}

