const { name, size = 20, class: className } = Astro.props as Props

if (!name) {
  throw new Error('Icon.astro: the "name" prop is required, e.g. <Icon name="crane" />')
}

const icon = ICONS[name]

if (!icon) {
  const known = Object.keys(ICONS).sort().join(', ')
  throw new Error(
    `Icon.astro: unknown icon name "${name}". Valid names are: ${known}. ` +
    `See docs/icon-map.md for the emoji → icon-name reference.`
  )
}

const isFill = icon.kind === 'fill'
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width={isFill ? undefined : 2}
  stroke-linecap={isFill ? undefined : 'round'}
  stroke-linejoin={isFill ? undefined : 'round'}
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>
