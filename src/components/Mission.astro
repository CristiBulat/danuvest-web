---
import { Image } from 'astro:assets'
import missionImg from '../assets/mission.jpg'
import Icon from './Icon.astro'
import mission from '../data/mission.json'

const [titleA, titleB] = mission.title.split('|')
---

<section class="section mission" id="misiune">
  <div class="container">
    <div class="mission-grid">
      <div class="mission-image">
        <div class="mission-image-inner">
          <Image src={missionImg} alt={mission.imageAlt} widths={[480, 800, 1200]} loading="lazy" />
        </div>
        <div class="mission-badge">
          <div class="mission-badge-value">{mission.badgeValue}</div>
          <div class="mission-badge-text">{mission.badgeText}</div>
        </div>
      </div>

      <div class="mission-content">
        <span class="section-label">{mission.label}</span>
        <h2 class="section-title">
          {titleA}{titleB && <br />}{titleB}
        </h2>

        <blockquote class="mission-quote">
          „{mission.quote}”
        </blockquote>

        <p class="section-desc">
          {mission.description}
        </p>

        <div class="mission-values">
          {mission.values.map((v) => (
            <div class="value-card">
              <div class="value-icon"><Icon name={v.icon} size={28} /></div>
              <div class="value-title">{v.title}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
