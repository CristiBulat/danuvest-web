---
// Self-hosted variable font: replaces the render-blocking Google Fonts
// stylesheet + two preconnects. Ships woff2 with a fluid 300–900 weight
// axis, so it covers every weight the old <link> pulled in bulk.
// Registers the family as 'Inter Variable' — the --font token in
// styles/tokens.css must name it exactly, or this silently falls back.
import '../styles/fonts.css'
import '../styles/main.css'
import Seo from '../components/Seo.astro'
import site from '../data/site.json'

interface Props {
  title?: string
  description?: string
  image?: string
}

const { title = site.metaTitle, description = site.metaDescription, image } = Astro.props

// '/' normally; '/danuvest-web/' on the GitHub Pages mirror build.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
---

<!DOCTYPE html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1c1c24" />

    <!-- Exported from src/assets/logo.jpg; lives in public/ so the URLs stay
         stable and unhashed, which is what browsers and iOS expect.
         BASE_URL keeps these correct on the GitHub Pages mirror, which
         builds under a /danuvest-web base path. -->
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <Seo title={title} description={description} image={image} />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
